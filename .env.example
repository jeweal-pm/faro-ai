# Copy to a private .env file for local development. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
FAROAI_DB_PASSWORD=replace-with-a-different-long-random-secret
FAROAI_INTERNAL_SECRET=replace-with-a-long-random-secret
API_KEY_PEPPER=replace-with-a-different-long-random-secret
QDRANT_API_KEY=replace-with-a-long-random-secret
QDRANT_READ_ONLY_API_KEY=replace-with-a-different-long-random-secret

# Optional model adapter. Leave MODEL_PROVIDER=none for deterministic local fallback.
MODEL_PROVIDER=none
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

PRODUCT_BASE_URL=https://www.example.com
OPENROUTER_DATA_COLLECTION=deny
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
QDRANT_COLLECTION=approved_knowledge_v1

# Jev 1.13 uses OpenRouter's Decisions API. FaroAI reads its encrypted key from
# the enabled OpenRouter provider connection in Backoffice; no separate env key is used.

# Legacy MCP endpoint credentials (new GIS/GMS/ERP connections belong in Backoffice).
MCP_CONNECTIONS_JSON={}
# Comma-separated exact hostnames approved for outbound MCP requests (no scheme or port).
MCP_ALLOWED_HOSTS=
MCP_ALLOW_DOCKER_HOST_HTTP=false

# Platform Backoffice. Leave disabled until OIDC or a local admin is configured.
FAROAI_DEPLOYMENT_MODE=hosted
FAROAI_TENANT_MODE=multi
FAROAI_SINGLE_TENANT_ID=
FAROAI_ALLOW_EXTERNAL_PROVIDERS=false
FAROAI_LOCAL_LLM_ENABLED=false
FAROAI_ALLOWED_LOCAL_MODEL_HOSTS=
BACKOFFICE_ENABLED=false
BACKOFFICE_URL=http://127.0.0.1:3001
BACKOFFICE_COOKIE_SECURE=false
BACKOFFICE_OIDC_ENABLED=false
BACKOFFICE_ADMIN_EMAILS=
BACKOFFICE_OIDC_ISSUER_URL=
BACKOFFICE_OIDC_CLIENT_ID=
BACKOFFICE_OIDC_CLIENT_SECRET=
BACKOFFICE_OIDC_REDIRECT_URI=http://127.0.0.1:3001/api/admin/auth/oidc/callback
BACKOFFICE_LOCAL_AUTH_ENABLED=false
BACKOFFICE_LOCAL_ADMIN_EMAIL=
BACKOFFICE_LOCAL_ADMIN_PASSWORD_HASH_B64=
FAROAI_CONFIG_ENCRYPTION_KEY=

# Public discovery is opt-in and server-side only. Configure after creating a tenant API key.
FAROAI_DEMO_ENABLED=false
FAROAI_DEMO_TENANT_ID=
FAROAI_DEMO_API_KEY=
FAROAI_API_INTERNAL_URL=http://api:3000
